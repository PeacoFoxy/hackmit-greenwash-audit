# Copy to .env and fill in the real value. .env is excluded by .gitignore.
# This is the only credential the project needs.

# Anthropic API key. Only two things require it:
#   1. claim extraction when you upload a new PDF
#   2. re-running src.extract / src.evaluate / src.coverage / src.trajectory
# The preloaded reports and the whole interface work without it (everything hits cache/).
ANTHROPIC_API_KEY=
